{
	"name": "test-time-adapting-harness",
	"version": "0.1.0",
	"description": "A self-improving coding-agent harness on pi: a Terminal-Bench agent whose harness learns from its own failures, plus Harness Learning (arXiv:2609.35738) for reasoning and QA tasks",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Singh-AP/test-time-adapting-harness.git"
	},
	"homepage": "https://github.com/Singh-AP/test-time-adapting-harness#readme",
	"engines": {
		"node": ">=22.19.0"
	},
	"bin": {
		"tta": "./src/cli.ts"
	},
	"scripts": {
		"test": "vitest run",
		"check": "biome check --write && tsc --noEmit",
		"tta": "node src/cli.ts",
		"test:py": ".venv-harbor/bin/python -m unittest discover -s python/tests -t .",
		"tbench": "scripts/tbench.sh",
		"check-model": "node scripts/check-model.ts"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.1.0",
		"@earendil-works/pi-codemode": "1.1.0",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@smithy/core": "3.35.2",
		"diff": "9.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	},
	"keywords": [
		"pi-package",
		"agent-harness",
		"terminal-bench",
		"harbor",
		"coding-agent",
		"harness-learning",
		"test-time-adaptation"
	],
	"pi": {
		"extensions": [
			"./src/pi/extension.ts"
		]
	}
}
